{
  "name": "dsh-plugin-turn-index",
  "version": "1.0.1",
  "description": "为会话右侧的轮次导航追加提问索引：展开全部提问、搜索过滤，点击即可跳转。在右侧索引列表底部增加展开箭头。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizongze/dsh-plugin-turn-index.git"
  },
  "homepage": "https://github.com/lizongze/dsh-plugin-turn-index#readme",
  "bugs": {
    "url": "https://github.com/lizongze/dsh-plugin-turn-index/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "turn",
    "outline",
    "navigation"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
